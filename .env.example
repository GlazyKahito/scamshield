# Google Gemini — the only external AI provider used by ScamShield.
# Get a key at https://aistudio.google.com/apikey
# Server-side only. NEVER prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=

# A current Gemini Flash model. Vision-capable models enable screenshot analysis.
GEMINI_MODEL=gemini-3.8-flash

# Optional. Tried in order when the main model is overloaded (503), out of
# quota (429) or unavailable (404). Defaults to the list below; set it empty
# to disable fallback.
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-2.5-flash
